{
  "name": "skillmate",
  "version": "1.0.0",
  "private": true,
  "description": "Student services marketplace powered by Express and Supabase",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
