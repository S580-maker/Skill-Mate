{
  "name": "skillflex",
  "version": "1.0.0",
  "private": true,
  "description": "Student services marketplace powered by Express and Supabase",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "typecheck": "tsc --project tsconfig.json",
    "build": "npm run typecheck && node scripts/build.cjs",
    "test:visual": "node tests/modernization-visual-check.cjs",
    "test:build": "node tests/production-build-check.cjs",
    "test:auth-network": "node tests/auth-network-browser-check.cjs",
    "test:modernization": "node tests/modernization-journey-check.cjs && node tests/navigation-focus-check.cjs && node tests/loading-modernization-browser.cjs && npm run test:auth-network",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser-mobile-smoke.cjs",
    "test:admin": "node tests/protected-admin-browser-check.cjs",
    "test:journey": "node tests/journey-browser-check.cjs",
    "test:release": "npm run build && npm test && npm run test:journey && npm run test:modernization && npm run test:admin && npm run test:loading:regressions && npm run test:db && npm run test:build",
    "test:loading": "node tests/loading-states-browser-checks.cjs",
    "test:loading:regressions": "node tests/loading-review-regressions.cjs",
    "test:landing": "node tests/browser-landing-smoke.cjs",
    "test:load": "node tests/local-load-test.cjs",
    "test:db": "node tests/marketplace-growth-db.cjs"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
