{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "crons": [
    {
      "path": "/api/booking-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "api/_lib/admin.html"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/landing.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/supabase-config.js",
      "destination": "/api/index?path=supabase-config"
    },
    {
      "source": "/admin.html",
      "destination": "/api/admin"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self';script-src 'self';script-src-attr 'none';style-src 'self' 'unsafe-inline';img-src 'self' data: blob: https:;font-src 'self';connect-src 'self' https: wss:;media-src 'self' blob: https:;worker-src 'self';object-src 'none';base-uri 'self';form-action 'self';frame-ancestors 'self'"
        }
      ]
    }
  ]
}
