SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Server-only; required for email OTP login and permanent account closure.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_OTP_SECRET=replace-with-at-least-32-random-characters
# SMTP credentials are server-only. SMTP_FROM may be the verified sender address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Skillmate <no-reply@example.com>
PORT=3000
NODE_ENV=development
# Optional shared rate limits for multi-instance hosting. Configure both values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional public contact details. Separate multiple emails with commas.
SUPPORT_EMAIL=ezekielnyarku1@gmail.com,steveobodai@gmail.com
# International phone digits only; leave empty to hide WhatsApp.
SUPPORT_WHATSAPP=
# Browser push keys generated with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.example
# Server-to-edge relay secret. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PUSH_DISPATCH_SECRET=replace-with-a-random-secret
# Set in Supabase Edge Function secrets, not needed in browser code.
PUSH_DISPATCH_URL=https://your-domain.example/api/push-dispatch

# Random server-only bearer secret for the daily booking reminders job.
CRON_SECRET=
# Optional: set these to the current project limits to enable capacity forecasts.
SUPABASE_DB_LIMIT_BYTES=
SUPABASE_STORAGE_LIMIT_BYTES=
